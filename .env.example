# Copy to .env and adjust. Never commit .env.

# Postgres connection used by the app, the worker and Prisma.
DATABASE_URL="postgresql://scope:scope@localhost:5432/scope_tracker"
# Separate database used only by `npm test`. It is wiped on every test run.
TEST_DATABASE_URL="postgresql://scope:scope@localhost:5432/scope_tracker_test"
# Password docker-compose gives the Postgres user. Must match the password in the two URLs above.
POSTGRES_PASSWORD="scope"

# Password for the two seeded demo users (pm@agency.test and member@agency.test).
SEED_PASSWORD="change-me"

# AI provider: "none" (default; every AI feature is off and manual flows are used)
# or "openai-compatible" (any OpenAI-style /chat/completions endpoint: Ollama, vLLM, hosted APIs).
AI_PROVIDER="none"
# openai-compatible only. Base URL without /chat/completions, e.g. http://localhost:11434/v1 for Ollama.
AI_BASE_URL=""
# openai-compatible only. Model name sent to the endpoint; also shown in the app header.
AI_MODEL=""
# openai-compatible only, optional. Sent as "Authorization: Bearer <key>".
AI_API_KEY=""
